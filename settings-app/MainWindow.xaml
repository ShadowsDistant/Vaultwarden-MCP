<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bitwarden MCP Settings"
        Width="1000" Height="740" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Page}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <!--
    Every brush comes from Theme.Apply in Theme.cs, by name, as a DynamicResource, so the light and
    dark palettes swap live. Every control style sets Foreground itself: a control's built-in theme
    style otherwise wins over inheritance and paints system black text on the dark palette, which
    is exactly the bug 0.3.0 shipped. The self-test walks every page and checks the contrast.

    Durations are written as literals. When animations are off the app rewrites every
    Duration in this file to zero before loading it, so the triggers still land on their final
    values, just instantly.
  -->
  <Window.Resources>

    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Text ===== -->
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Margin" Value="0,6,0,4" />
    </Style>

    <Style x:Key="PageDesc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Margin" Value="2,26,0,10" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Margin" Value="1,14,0,6" />
    </Style>

    <Style x:Key="Desc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="Message" TargetType="TextBlock" BasedOn="{StaticResource Desc}">
      <Setter Property="Margin" Value="1,12,0,0" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20,18" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="Margin" Value="0,16,0,16" />
    </Style>

    <Style x:Key="Callout" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}" />
    </Style>

    <!-- ===== Toggle switch: the knob slides, the track fills ===== -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="42" Height="22" Background="Transparent">
              <Border x:Name="Ring" CornerRadius="14" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Margin="-3" Visibility="Collapsed" />
              <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" />
              <Border x:Name="Fill" CornerRadius="11" Background="{DynamicResource Accent}" Opacity="0" />
              <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="0" />
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentFg}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A plain check box, for the welcome screen's shortcut choices -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Surface2}" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="Tick" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource AccentFg}" Opacity="0" />
              </Border>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== A selectable option card with a title and description ===== -->
    <Style x:Key="Option" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Box" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" />
              <Border x:Name="Sel" CornerRadius="9" Background="{DynamicResource AccentSoft}" Opacity="0" />
              <Border x:Name="Hov" CornerRadius="9" Background="{DynamicResource Hover}" Opacity="0" />
              <Border x:Name="Edge" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Padding="14,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                    <Ellipse x:Name="Outer" Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5" />
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="0" ScaleY="0" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                  </Grid>
                  <ContentPresenter Grid.Column="1" />
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Accent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                      <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                      <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.12" />
                      <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Edge" Property="BorderThickness" Value="2" />
                <Setter TargetName="Edge" Property="Padding" Value="13,11" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== A chip in a segmented choice ===== -->
    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="B" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface2}" />
              <Border x:Name="Hov" CornerRadius="8" Background="{DynamicResource Hover}" Opacity="0" />
              <Border x:Name="On" CornerRadius="8" Background="{DynamicResource Accent}" Opacity="0" />
              <Border x:Name="Pad" Padding="13,6" BorderThickness="0" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Pad" Property="BorderBrush" Value="{DynamicResource Fg}" />
                <Setter TargetName="Pad" Property="BorderThickness" Value="1.5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Navigation item ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="GroupName" Value="nav" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="Hov" CornerRadius="8" Background="{DynamicResource Hover}" Opacity="0" />
              <Border x:Name="Focus" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Visibility="Collapsed" />
              <StackPanel Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="20" Foreground="{TemplateBinding Foreground}" />
                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="B" CornerRadius="8" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
              <Border x:Name="Hov" CornerRadius="8" Background="{DynamicResource Hover}" Opacity="0" />
              <Border x:Name="Prs" CornerRadius="8" Background="{DynamicResource Hover}" Opacity="0" />
              <Border x:Name="Ring" CornerRadius="8" BorderBrush="{DynamicResource Fg}" BorderThickness="1.5" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Prs" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource DangerFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
    </Style>

    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="LinkBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Link}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Background="Transparent" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Inputs. The placeholder is the control's Tag. ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="SelectionOpacity" Value="0.45" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu>
            <MenuItem Command="ApplicationCommands.Cut" />
            <MenuItem Command="ApplicationCommands.Copy" />
            <MenuItem Command="ApplicationCommands.Paste" />
          </ContextMenu>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="B" CornerRadius="8" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
              <Border x:Name="Under" Height="2" CornerRadius="0,0,8,8" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Opacity="0" Margin="1,0,1,0" />
              <TextBlock x:Name="Ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Faint}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Under" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Under" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="PasswordChar" Value="&#x25CF;" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Grid>
              <Border x:Name="B" CornerRadius="8" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
              <Border x:Name="Under" Height="2" CornerRadius="0,0,8,8" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Opacity="0" Margin="1,0,1,0" />
              <TextBlock x:Name="Ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Faint}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Under" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Under" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Menus and tooltips, so nothing falls back to the system's light look ===== -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
              <StackPanel IsItemsHost="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="B" CornerRadius="6" Padding="12,6" Background="Transparent" MinWidth="120">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Faint}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,4">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="3" Background="{DynamicResource LineStrong}" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource Faint}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A row: text on the left, a switch on the right -->
    <Style x:Key="RowText" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,20,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================= Navigation ================= -->
    <Border Grid.Column="0" Background="{DynamicResource Nav}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="20,22,16,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,12,0">
            <Image x:Name="Logo" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Bitwarden MCP" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI Variable Display, Segoe UI" />
            <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom" Margin="14,10,14,16" Padding="12,10" CornerRadius="9" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ServerIcon" Style="{StaticResource Icon}" FontSize="14" Text="&#xE839;" Foreground="{DynamicResource Muted}" Margin="0,1,10,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="ServerTitle" Text="Extension not running" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ServerSub" Text="" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid x:Name="NavHost" Margin="10,4,10,0">
          <Canvas x:Name="NavPillLayer" IsHitTestVisible="False" ClipToBounds="False">
            <Border x:Name="NavPill" Height="38" CornerRadius="8" Background="{DynamicResource AccentSoft}">
              <Border.RenderTransform>
                <TranslateTransform x:Name="NavPillMove" />
              </Border.RenderTransform>
              <Border Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
          </Canvas>
          <StackPanel x:Name="NavList">
            <RadioButton x:Name="NavAccount" Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="Account" />
            <RadioButton x:Name="NavPermissions" Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Permissions" />
            <RadioButton x:Name="NavSecurity" Style="{StaticResource NavItem}" Tag="&#xE72E;" Content="Locking and timers" />
            <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="General" />
            <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Tag="&#xE777;" Content="Updates" />
            <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Activity" />
            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ================= Content ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="BusyTrack" Grid.Row="0" Height="2" VerticalAlignment="Top" Visibility="Hidden" ClipToBounds="True" Background="{DynamicResource AccentSoft}" IsHitTestVisible="False" Panel.ZIndex="5">
        <Border x:Name="BusySegment" HorizontalAlignment="Left" Width="120" Background="{DynamicResource Accent}" CornerRadius="1" />
      </Border>
      <StackPanel Grid.Row="0" Margin="40,16,36,0">
        <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="10" Padding="14,10" BorderThickness="1" Margin="0,0,0,8" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}">
          <Border.RenderTransform>
            <TranslateTransform />
          </Border.RenderTransform>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Accent}" Margin="2,0,12,0" />
            <TextBlock x:Name="UpdateBannerText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Fg}" Text="An update is available." />
            <Button x:Name="UpdateBannerBtn" Grid.Column="2" Style="{StaticResource SmallBtn}" Content="See update" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <Border x:Name="Banner" Visibility="Collapsed" Style="{StaticResource Callout}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="2,1,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="BannerText" Grid.Column="1" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource Fg}" />
          </Grid>
        </Border>
      </StackPanel>

      <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="PageHost" Margin="40,8,32,40" MaxWidth="820" HorizontalAlignment="Stretch">

          <!-- ============ Account ============ -->
          <StackPanel x:Name="PageAccount" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="Account" />
            <TextBlock Style="{StaticResource PageDesc}" Text="Sign in to your Bitwarden or self-hosted Vaultwarden account. What you type goes straight to the Bitwarden command-line tool on this computer. It's never saved, and your AI assistant never sees it." />

            <Border x:Name="AccountCard" Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="AvatarText" Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Muted}" Margin="2,0,16,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AcctTitle" Style="{StaticResource Label}" FontSize="15" Text="Not signed in" />
                    <TextBlock x:Name="AcctSub" Style="{StaticResource Desc}" Text="" />
                  </StackPanel>
                  <Border x:Name="AcctChip" Grid.Column="2" CornerRadius="5" Padding="8,3" VerticalAlignment="Center" Background="{DynamicResource Surface3}">
                    <TextBlock x:Name="AcctChipText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Text="Signed out" />
                  </Border>
                </Grid>

                <Grid x:Name="UnlockRow" Visibility="Collapsed" Margin="0,18,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <PasswordBox x:Name="UnlockPassword" Tag="Master password" AutomationProperties.Name="Master password to unlock" />
                  <Button x:Name="UnlockBtn" Grid.Column="1" Style="{StaticResource PrimaryBtn}" Content="Unlock" MinWidth="104" Margin="8,0,0,0" />
                </Grid>

                <TextBlock x:Name="AcctMessage" Style="{StaticResource Message}" />
                <Button x:Name="ResignLink" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Content="Sign out and sign in again" />

                <WrapPanel x:Name="AcctActions" Margin="0,16,0,0">
                  <Button x:Name="LockBtn" Style="{StaticResource SmallBtn}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource Fg}" />
                      <TextBlock Text="Lock now" Foreground="{DynamicResource Fg}" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="SignOutBtn" Style="{StaticResource SmallBtn}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xF3B1;" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource Fg}" />
                      <TextBlock Text="Sign out" Foreground="{DynamicResource Fg}" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <TextBlock x:Name="SignInTitle" Style="{StaticResource SectionTitle}" Text="Sign in" />
            <Border x:Name="SignInCard" Style="{StaticResource Card}">
              <StackPanel x:Name="SignInStack">
                <StackPanel x:Name="LocationPanel">
                  <TextBlock Style="{StaticResource Label}" Text="Where is your vault?" />
                  <TextBlock Style="{StaticResource Desc}" Margin="0,3,0,12" Text="Pick Bitwarden's cloud, or enter the address of your own Vaultwarden or Bitwarden server." />
                  <WrapPanel>
                    <RadioButton x:Name="LocUs" GroupName="loc" Style="{StaticResource Pill}" Content="Bitwarden.com" />
                    <RadioButton x:Name="LocEu" GroupName="loc" Style="{StaticResource Pill}" Content="Bitwarden.eu" />
                    <RadioButton x:Name="LocSelf" GroupName="loc" Style="{StaticResource Pill}" Content="Self-hosted" />
                  </WrapPanel>
                  <StackPanel x:Name="SelfHostRow" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Server address" />
                    <TextBox x:Name="UrlInput" Tag="https://vault.example.com" AutomationProperties.Name="Server address" />
                  </StackPanel>
                  <TextBlock x:Name="LocNote" Style="{StaticResource Desc}" Margin="1,8,0,0" Text="" />
                  <TextBlock x:Name="UrlError" Style="{StaticResource Message}" Foreground="{DynamicResource Danger}" />
                </StackPanel>

                <StackPanel x:Name="CredsPanel">
                  <Border x:Name="CredsDivider" Style="{StaticResource Divider}" Margin="0,18,0,2" />
                  <StackPanel x:Name="PwMode">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Email" />
                    <TextBox x:Name="EmailInput" Tag="you@example.com" AutomationProperties.Name="Email" />
                  </StackPanel>
                  <StackPanel x:Name="KeyMode" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID" />
                    <TextBox x:Name="ClientIdInput" Tag="user.xxxxxxxx-xxxx-..." AutomationProperties.Name="API key client ID" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Client secret" />
                    <PasswordBox x:Name="ClientSecretInput" Tag="Client secret" AutomationProperties.Name="API key client secret" />
                    <TextBlock Style="{StaticResource Desc}" Margin="1,8,0,0" Text="Find these in the web vault under Account settings, Security, Keys, View API key. The key signs you in; your master password still unlocks the vault." />
                  </StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Master password" />
                  <PasswordBox x:Name="MasterInput" Tag="Master password" AutomationProperties.Name="Master password" />

                  <Border x:Name="TwoStepPanel" Visibility="Collapsed" Margin="0,18,0,0" CornerRadius="9" Padding="16,14" BorderThickness="1" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Label}" Text="Two-step login" />
                      </StackPanel>
                      <TextBlock x:Name="TwoStepText" Style="{StaticResource Desc}" Margin="0,6,0,12" Text="Your account asks for a second step. Choose how you get your code." />
                      <WrapPanel>
                        <RadioButton x:Name="MethodApp" GroupName="method" Style="{StaticResource Pill}" Content="Authenticator app" IsChecked="True" />
                        <RadioButton x:Name="MethodEmail" GroupName="method" Style="{StaticResource Pill}" Content="Email" />
                        <RadioButton x:Name="MethodKey" GroupName="method" Style="{StaticResource Pill}" Content="YubiKey" />
                      </WrapPanel>
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CodeInput" Tag="Code" AutomationProperties.Name="Two-step code" />
                        <Button x:Name="SendCodeBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Email me a code" Margin="8,0,0,0" Visibility="Collapsed" />
                      </Grid>
                      <TextBlock Style="{StaticResource Desc}" Margin="0,12,0,0" Text="Passkey sign-in and &quot;log in with device&quot; aren't supported by the Bitwarden command-line tool. If Bitwarden emailed you a new-device verification code, sign in with your personal API key instead." />
                      <Button x:Name="UseKeyLink" Style="{StaticResource LinkBtn}" Content="Sign in with an API key" Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>

                  <TextBlock x:Name="SignInMessage" Style="{StaticResource Message}" />

                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ModeLink" Style="{StaticResource LinkBtn}" Content="Use an API key instead" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Button x:Name="SaveLocBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Save for later" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="SignInBtn" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="Sign in" MinWidth="112" />
                  </Grid>
                  <TextBlock x:Name="ServerNote" Style="{StaticResource Desc}" Margin="1,12,0,0" Visibility="Collapsed" Text="Open your AI app with the Bitwarden extension turned on to finish signing in. You can save the address and email now." />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ Permissions ============ -->
          <StackPanel x:Name="PagePermissions" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="Permissions" />
            <TextBlock Style="{StaticResource PageDesc}" Text="Decide what your AI assistant may do with your vault. It can't change any of this itself: only you can, here." />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Passwords and codes" />
            <Border x:Name="AccessCard" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="When the assistant asks to read or copy a secret" />
                <TextBlock Style="{StaticResource Desc}" Text="Covers passwords, one-time codes and notes. You can always reveal and copy them yourself in the vault card." />
                <RadioButton x:Name="AccessAsk" GroupName="access" Style="{StaticResource Option}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Ask me every time" />
                    <TextBlock Style="{StaticResource Desc}" Text="A window on your desktop asks before the assistant gets each one." />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AccessSession" GroupName="access" Style="{StaticResource Option}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Ask once per login" />
                    <TextBlock Style="{StaticResource Desc}" Text="You're asked the first time for each login. Locking the vault resets this." />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AccessNever" GroupName="access" Style="{StaticResource Option}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Never" />
                    <TextBlock Style="{StaticResource Desc}" Text="The assistant can't read or copy secrets, except for your trusted sites." />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Trusted sites" />
            <Border x:Name="SitesCard" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Desc}" Margin="0" Text="For these sites the assistant can read and copy the password and one-time code without asking. Notes are never shared this way, and logins set to re-prompt for your master password are always left out. A login only counts if every web address saved on it is trusted." />
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="SiteInput" Tag="example.com" AutomationProperties.Name="Site to trust" />
                  <Button x:Name="SiteAdd" Grid.Column="1" Style="{StaticResource Btn}" Content="Add site" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="SiteError" Style="{StaticResource Message}" Foreground="{DynamicResource Danger}" Margin="2,8,0,0" />
                <TextBlock x:Name="SiteEmpty" Style="{StaticResource Desc}" Margin="2,12,0,2" FontStyle="Italic" Text="No trusted sites yet. The assistant follows the choice above for every login." />
                <StackPanel x:Name="SiteList" Margin="0,6,0,0" />
                <TextBlock x:Name="SiteRejected" Style="{StaticResource Message}" Foreground="{DynamicResource Danger}" Margin="2,10,0,0" />
                <TextBlock Style="{StaticResource Desc}" Margin="2,12,0,0" Text="Subdomains count: trusting github.com also covers gist.github.com. Shared hosting addresses such as github.io can't be trusted as a whole." />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Changes to your vault" />
            <Border x:Name="ChangesCard" Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Style="{StaticResource Label}" Text="Let the assistant prepare new logins and edits" />
                    <TextBlock Style="{StaticResource Desc}" Text="Nothing is saved until you confirm it. When off, the assistant can only look." />
                  </StackPanel>
                  <CheckBox x:Name="AllowChanges" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Let the assistant prepare new logins and edits" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid x:Name="TrashRow" Margin="22,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Style="{StaticResource Label}" Text="Also let it move items to the trash" />
                    <TextBlock x:Name="TrashDesc" Style="{StaticResource Desc}" Text="You confirm each one, and trashed items can be restored from the trash in your vault. Nothing is ever deleted permanently." />
                  </StackPanel>
                  <CheckBox x:Name="AllowTrash" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Let the assistant move items to the trash" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ Locking and timers ============ -->
          <StackPanel x:Name="PageSecurity" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="Locking and timers" />
            <TextBlock Style="{StaticResource PageDesc}" Text="How long your vault stays open, and how long a password stays on screen or on the clipboard." />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Lock the vault" />
            <Border x:Name="LockCard" Style="{StaticResource Card}">
              <StackPanel>
                <RadioButton x:Name="LockExit" GroupName="lock" Style="{StaticResource Option}" Margin="0">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="When my AI app closes" />
                    <TextBlock Style="{StaticResource Desc}" Text="The default. Quitting the app, or the extension restarting, locks the vault." />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LockIdle" GroupName="lock" Style="{StaticResource Option}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="After a period of inactivity" />
                    <TextBlock Style="{StaticResource Desc}" Text="Locks once the vault hasn't been used for a while, and also when the app closes." />
                  </StackPanel>
                </RadioButton>
                <StackPanel x:Name="IdleRow" Visibility="Collapsed" Margin="44,12,0,2">
                  <TextBlock Style="{StaticResource Desc}" Margin="0,0,0,8" Text="Lock after" />
                  <WrapPanel x:Name="IdlePills" />
                </StackPanel>
                <RadioButton x:Name="LockNever" GroupName="lock" Style="{StaticResource Option}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Never" />
                    <TextBlock Style="{StaticResource Desc}" Text="Stays unlocked, even after a restart, until you lock it yourself." />
                  </StackPanel>
                </RadioButton>
                <Border x:Name="NeverWarning" Style="{StaticResource Callout}" Visibility="Collapsed" Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource Fg}" Text="Your vault's unlock key is kept on this computer, encrypted so only your Windows account can read it. Anyone who can use this Windows account, and any program you run, can then open your vault without the master password. Only choose this on a computer you alone use." />
                  </Grid>
                </Border>
                <Border Style="{StaticResource Divider}" Margin="0,18,0,14" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Desc}" Margin="0" VerticalAlignment="Center" Text="Lock right away, whatever you choose here." />
                  <Button x:Name="LockNowBtn2" Grid.Column="1" Style="{StaticResource SmallBtn}" Content="Lock now" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Timers" />
            <Border x:Name="TimersCard" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Hide a revealed password after" />
                <TextBlock Style="{StaticResource Desc}" Margin="0,3,0,10" Text="When you reveal a password in the vault card." />
                <WrapPanel x:Name="RevealPills" />
                <Border Style="{StaticResource Divider}" Margin="0,10,0,16" />
                <TextBlock Style="{StaticResource Label}" Text="Clear a copied password from the clipboard after" />
                <TextBlock Style="{StaticResource Desc}" Margin="0,3,0,10" Text="Only if it's still there. Anything you copied since is left alone." />
                <WrapPanel x:Name="ClipPills" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ General ============ -->
          <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="General" />
            <TextBlock Style="{StaticResource PageDesc}" Text="How the vault looks in your chats, and how this window looks." />

            <TextBlock Style="{StaticResource SectionTitle}" Text="In the chat" />
            <Border x:Name="CardsCard" Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource RowText}">
                  <TextBlock Style="{StaticResource Label}" Text="Show vault cards" />
                  <TextBlock Style="{StaticResource Desc}" Text="Interactive cards for browsing, revealing and adding passwords, in apps that can show them. When off, the assistant answers in plain text and you confirm changes in desktop windows. Takes effect the next time your AI app starts the extension." />
                  <TextBlock x:Name="CardsNote" Style="{StaticResource Message}" Foreground="{DynamicResource Warn}" Margin="0,8,0,0" />
                </StackPanel>
                <CheckBox x:Name="Cards" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Show vault cards" />
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
            <Border x:Name="AppearanceCard" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Theme" />
                <TextBlock Style="{StaticResource Desc}" Margin="0,3,0,10" Text="For this window." />
                <WrapPanel>
                  <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Pill}" Content="Match Windows" />
                  <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Pill}" Content="Light" />
                  <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Pill}" Content="Dark" />
                </WrapPanel>
                <Border Style="{StaticResource Divider}" Margin="0,10,0,16" />
                <TextBlock Style="{StaticResource Label}" Text="Animations" />
                <TextBlock x:Name="AnimDesc" Style="{StaticResource Desc}" Margin="0,3,0,10" Text="Page transitions and small motion in this window." />
                <WrapPanel>
                  <RadioButton x:Name="AnimOn" GroupName="anim" Style="{StaticResource Pill}" Content="On" />
                  <RadioButton x:Name="AnimSystem" GroupName="anim" Style="{StaticResource Pill}" Content="Match Windows" />
                  <RadioButton x:Name="AnimOff" GroupName="anim" Style="{StaticResource Pill}" Content="Off" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ Updates ============ -->
          <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="Updates" />
            <TextBlock Style="{StaticResource PageDesc}" Text="Security fixes arrive as updates, so it's worth staying current." />

            <Border x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="UpdIconBox" Width="24" Margin="2,0,14,0" VerticalAlignment="Center" Background="Transparent">
                    <TextBlock x:Name="UpdIcon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="20" Foreground="{DynamicResource Success}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdTitle" Style="{StaticResource Label}" FontSize="15" Text="You're up to date" />
                    <TextBlock x:Name="UpdSub" Style="{StaticResource Desc}" Text="" />
                  </StackPanel>
                  <Button x:Name="CheckBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Check now" MinWidth="118" VerticalAlignment="Center" />
                </Grid>

                <StackPanel x:Name="UpdProgress" Visibility="Collapsed" Margin="0,18,0,0">
                  <Border x:Name="UpdTrack" Height="6" CornerRadius="3" Background="{DynamicResource Surface3}" ClipToBounds="True">
                    <Border x:Name="UpdFill" Height="6" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0" />
                  </Border>
                  <TextBlock x:Name="UpdProgressText" Style="{StaticResource Desc}" Margin="0,8,0,0" Text="" />
                </StackPanel>

                <TextBlock x:Name="UpdMessage" Style="{StaticResource Message}" />

                <WrapPanel x:Name="UpdActions" Margin="0,16,0,0" Visibility="Collapsed">
                  <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryBtn}" Content="Download and install" Margin="0,0,8,0" />
                  <Button x:Name="NotesBtn" Style="{StaticResource Btn}" Content="What's new" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Style="{StaticResource Label}" Text="Check for updates automatically" />
                    <TextBlock Style="{StaticResource Desc}" Text="Asks GitHub for the latest release every few hours, and tells you here and in your chats when there's a new one. Nothing about you or your vault is sent." />
                  </StackPanel>
                  <CheckBox x:Name="UpdateCheck" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Check for updates automatically" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource Desc}" Margin="0" Text="Extension" />
                  <TextBlock x:Name="ExtVersion" Grid.Column="1" Style="{StaticResource Desc}" Margin="0" Foreground="{DynamicResource Fg}" Text="-" />
                  <TextBlock Grid.Row="1" Style="{StaticResource Desc}" Margin="0,6,0,0" Text="Settings app" />
                  <TextBlock x:Name="AppVersion" Grid.Row="1" Grid.Column="1" Style="{StaticResource Desc}" Margin="0,6,0,0" Foreground="{DynamicResource Fg}" Text="-" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ Activity ============ -->
          <StackPanel x:Name="PageActivity" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="Activity" />
            <TextBlock Style="{StaticResource PageDesc}" Text="Every time your AI assistant searched your vault, read or copied a password, or prepared a change, and what you allowed. Kept only on this computer. It names items and sites, never usernames, passwords or codes." />
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <WrapPanel VerticalAlignment="Center">
                    <RadioButton x:Name="ActAll" GroupName="act" Style="{StaticResource Pill}" Content="All" IsChecked="True" />
                    <RadioButton x:Name="ActSecrets" GroupName="act" Style="{StaticResource Pill}" Content="Passwords and codes" />
                    <RadioButton x:Name="ActChanges" GroupName="act" Style="{StaticResource Pill}" Content="Changes" />
                    <RadioButton x:Name="ActAccount" GroupName="act" Style="{StaticResource Pill}" Content="Sign-in and locking" />
                  </WrapPanel>
                  <Button x:Name="RefreshActivity" Grid.Column="1" Style="{StaticResource SmallBtn}" Content="Refresh" VerticalAlignment="Top" Margin="12,0,0,0" />
                </Grid>
                <TextBox x:Name="ActivitySearch" Tag="Search by item, site or action" Margin="0,14,0,0" AutomationProperties.Name="Search activity" />
                <TextBlock x:Name="ActivityCount" Style="{StaticResource Desc}" Margin="0,12,0,6" Text="" />
                <StackPanel x:Name="ActivityList" />
                <TextBlock x:Name="ActivityEmpty" Style="{StaticResource Desc}" Margin="0,8,0,4" Visibility="Collapsed" Text="" />
                <TextBlock x:Name="ActivityMsg" Style="{StaticResource Message}" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="History" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Style="{StaticResource Label}" Text="Keep an activity history" />
                    <TextBlock Style="{StaticResource Desc}" Text="Turn this off and nothing new is recorded. What's already here stays until you clear it." />
                  </StackPanel>
                  <CheckBox x:Name="ActivityLogSwitch" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Keep an activity history" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource RowText}">
                    <TextBlock Style="{StaticResource Label}" Text="Clear history" />
                    <TextBlock Style="{StaticResource Desc}" Text="Deletes everything on this page from this computer." />
                  </StackPanel>
                  <Button x:Name="ClearActivity" Grid.Column="1" Style="{StaticResource SmallBtn}" Content="Clear" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ About ============ -->
          <StackPanel x:Name="PageAbout" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitle}" Text="About" />
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="60" Height="60" CornerRadius="14" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,18,0" VerticalAlignment="Top">
                  <Image x:Name="AboutLogo" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Style="{StaticResource Label}" FontSize="17" Text="Bitwarden MCP" />
                  <TextBlock x:Name="AboutVersion" Style="{StaticResource Desc}" Text="" />
                  <TextBlock Style="{StaticResource Desc}" Margin="0,10,0,0" Text="Connects AI assistants to your Bitwarden or self-hosted Vaultwarden vault through the official Bitwarden command-line tool, with you in charge of every secret." />
                  <TextBlock Style="{StaticResource Desc}" Margin="0,8,0,0" Text="Unofficial. Not affiliated with Bitwarden, Inc. Licensed under the GNU GPL v3 or later." />
                  <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="OpenHelp" Style="{StaticResource SmallBtn}" Content="Setup guide" Margin="0,0,8,6" />
                    <Button x:Name="OpenIssues" Style="{StaticResource SmallBtn}" Content="Report a problem" Margin="0,0,8,6" />
                    <Button x:Name="OpenRepo" Style="{StaticResource SmallBtn}" Content="Source on GitHub" Margin="0,0,8,6" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Shortcuts" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Desc}" Margin="0" Text="Open these settings without going through your AI app." />
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="DesktopShortcutBtn" Style="{StaticResource SmallBtn}" Content="Add a desktop shortcut" Margin="0,0,8,0" />
                  <Button x:Name="StartShortcutBtn" Style="{StaticResource SmallBtn}" Content="Add to the Start menu" />
                </WrapPanel>
                <TextBlock x:Name="ShortcutMsg" Style="{StaticResource Message}" />
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Your settings file" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Desc}" Margin="0" Text="Stored on this computer. The extension reads it before every request, and has no way to write it." />
                <TextBlock x:Name="FilePath" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,12" />
                <WrapPanel>
                  <Button x:Name="OpenFolder" Style="{StaticResource SmallBtn}" Content="Open folder" Margin="0,0,8,0" />
                  <Button x:Name="ResetDefaults" Style="{StaticResource SmallBtn}" Content="Reset to defaults" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ============ Save bar ============ -->
      <Border x:Name="SaveBar" Grid.Row="2" Visibility="Collapsed" Margin="40,0,36,18" Padding="18,12" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Surface}">
        <Border.RenderTransform>
          <TranslateTransform />
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18" Color="Black" />
        </Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SaveIcon" Style="{StaticResource Icon}" Text="&#xE70F;" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" />
          <TextBlock x:Name="FooterText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Fg}" Text="You have unsaved changes." />
          <Button x:Name="DiscardBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Discard" Margin="12,0,8,0" />
          <Button x:Name="SaveBtn" Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="Save" MinWidth="96" ToolTip="Ctrl+S" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================= Welcome ================= -->
    <Grid x:Name="Welcome" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Page}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="28,20,28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="WelcomeLogo" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Grid.Column="1" Text="Bitwarden MCP" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
        <Button x:Name="SkipWelcome" Grid.Column="2" Style="{StaticResource LinkBtn}" Content="Set up later" VerticalAlignment="Center" FontSize="13" />
      </Grid>

      <ScrollViewer x:Name="WelcomeScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="WelcomeHost" MaxWidth="620" Margin="32,18,32,24">

          <StackPanel x:Name="WStep1" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Desc}" Text="STEP 1 OF 4" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
            <TextBlock Style="{StaticResource PageTitle}" FontSize="30" Text="Welcome to Bitwarden MCP" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource PageDesc}" FontSize="14" LineHeight="22" Text="Let your AI assistant find, copy and save logins in your Bitwarden vault, while you stay in charge of every secret. Setup takes about a minute." />
            <Border x:Name="WLocHost" Style="{StaticResource Card}" Margin="0,20,0,0" />
          </StackPanel>

          <StackPanel x:Name="WStep2" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Desc}" Text="STEP 2 OF 4" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
            <TextBlock Style="{StaticResource PageTitle}" FontSize="30" Text="Sign in" />
            <TextBlock x:Name="WSignInDesc" Style="{StaticResource PageDesc}" FontSize="14" LineHeight="22" Text="Your master password goes straight to the Bitwarden command-line tool on this computer. It's never saved, and your assistant never sees it." />
            <Border x:Name="WSignedIn" Style="{StaticResource Callout}" Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource SuccessLine}" Margin="0,20,0,0" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource Success}" Margin="0,0,12,0" />
                <TextBlock x:Name="WSignedInText" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Text="You're signed in." />
              </StackPanel>
            </Border>
            <Border x:Name="WCredsHost" Style="{StaticResource Card}" Margin="0,20,0,0" />
          </StackPanel>

          <StackPanel x:Name="WStep3" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Desc}" Text="STEP 3 OF 4" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
            <TextBlock Style="{StaticResource PageTitle}" FontSize="30" Text="What may your assistant do?" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource PageDesc}" FontSize="14" LineHeight="22" Text="You can change these any time in Permissions." />
            <Border x:Name="WAccessHost" Margin="0,18,0,0" />
            <Border x:Name="WChangesHost" Margin="0,12,0,0" />
          </StackPanel>

          <StackPanel x:Name="WStep4" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Desc}" Text="STEP 4 OF 4" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
            <TextBlock Style="{StaticResource PageTitle}" FontSize="30" Text="You're all set" />
            <TextBlock Style="{StaticResource PageDesc}" FontSize="14" LineHeight="22" Text="Head back to your AI app and try asking:" />
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" />
                <TextBlock Text="&quot;What's my login for github.com?&quot;" FontSize="14" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Desc}" Margin="0,10,0,0" Text="If your vault is locked, a window on your desktop asks for your master password." />
            <TextBlock Style="{StaticResource SectionTitle}" Text="Shortcuts" Margin="2,24,0,0" />
            <CheckBox x:Name="WDesktop" Style="{StaticResource Check}" IsChecked="True">
              <TextBlock Text="Add a desktop shortcut to these settings" Foreground="{DynamicResource Fg}" />
            </CheckBox>
            <CheckBox x:Name="WStartMenu" Style="{StaticResource Check}" IsChecked="True">
              <TextBlock Text="Add to the Start menu" Foreground="{DynamicResource Fg}" />
            </CheckBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="28,14">
        <Grid MaxWidth="620">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="StepDots" Orientation="Horizontal" VerticalAlignment="Center" />
          <Button x:Name="WBack" Grid.Column="1" Style="{StaticResource Btn}" Content="Back" Margin="0,0,8,0" />
          <Button x:Name="WNext" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="Continue" MinWidth="120" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================= Dialog ================= -->
    <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Scrim}">
      <Border x:Name="DialogCard" Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform />
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <StackPanel>
          <TextBlock x:Name="DlgTitle" Style="{StaticResource Label}" FontSize="17" Text="" />
          <TextBlock x:Name="DlgText" Style="{StaticResource Desc}" FontSize="13" LineHeight="20" Margin="0,8,0,0" Text="" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="DlgCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" />
            <Button x:Name="DlgAlt" Style="{StaticResource Btn}" Content="" Margin="0,0,8,0" Visibility="Collapsed" />
            <Button x:Name="DlgOk" Style="{StaticResource PrimaryBtn}" Content="OK" MinWidth="96" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
